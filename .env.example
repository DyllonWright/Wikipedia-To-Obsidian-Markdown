# Wikipedia to Markdown — local web GUI environment (`npm start`)
# Copy to .env and fill in. .env and every .env.* variant stay gitignored.
# Gemini stays optional: with no key, offline heuristics name images.

# One key…
GEMINI_API_KEY=your_gemini_api_key_here

# …or several, comma-separated, rotated when one runs out of daily quota:
# GEMINI_API_KEYS=key_one,key_two

# …or the fleet's shared ring file (read only, never rewritten):
# ENV_KEY_RING_PATH=C:/Users/you/.env-key-ring/keys.env

PORT=3000
