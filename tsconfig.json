{
	"compilerOptions": {
		"baseUrl": ".",
		"target": "ES2019",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"esModuleInterop": true,
		"allowJs": false,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"importHelpers": false,
		"lib": ["DOM", "DOM.Iterable", "ES2019", "ES2020.String"]
	},
	"include": ["plugin/**/*.ts", "src/**/*.d.ts"]
}
