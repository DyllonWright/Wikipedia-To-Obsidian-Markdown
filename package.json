{
  "name": "wikipedia-to-obsidian-markdown",
  "version": "2.0.2",
  "description": "Import Wikipedia articles as clean Obsidian markdown: a self-contained Obsidian plugin, plus an optional local web GUI, sharing one parser.",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "server": "node --watch server.js",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node test/run.mjs"
  },
  "keywords": ["obsidian", "obsidian-plugin", "wikipedia", "markdown"],
  "author": "Dyllon Wright",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.6.0"
  }
}
